#!/bin/bash
#ddev-generated
## Description: Creates inaccessible mounts for sensitive paths.

set -e

# Navigate to project root.
PROJECT_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$PROJECT_ROOT"

# Define the config file and target file paths.
CONFIG_FILE="${PROJECT_ROOT}/.ddev/agents.sensitive-paths.txt"
TARGET_FILE="${PROJECT_ROOT}/.ddev/docker-compose.agents-sensitive-paths.yaml"

# Check if config file exists.
if [ ! -f "$CONFIG_FILE" ]; then
    rm -f "$TARGET_FILE"
    echo "⚠️ Agents config file not found ($CONFIG_FILE). Removing generated Docker compose file."
    exit 0
fi

# Extract the sensitive paths from the config .txt file.
# Ignore comments (#) and empty lines.
PATHS=$(while IFS= read -r line || [ -n "$line" ]; do
    # Ignore comments or empty lines
    [[ "$line" =~ ^#.*$ ]] || [ -z "$line" ] && continue
    echo "$line"
done < "$CONFIG_FILE")

# Check if paths are read.
if [ -z "$PATHS" ]; then
    echo "⚠️ No sensitive paths defined in $CONFIG_FILE. Removing $TARGET_FILE."
    rm -f "$TARGET_FILE"
    exit 0
fi

PATH_COUNT=0
VALID_PATHS=""

# Loop through the paths.
while read -r sensitive_path; do
    [ -z "$sensitive_path" ] && continue

    # The path must be relative, no '..', no directories, and NO wildcards.
    if [[ "$sensitive_path" == /* ]] || [[ "$sensitive_path" == *..* ]] || [[ "$sensitive_path" == *"*"* ]]; then
        echo "⚠️ Skipping invalid path (absolute, traversal, or contains a wildcard): $sensitive_path"
        continue
    fi

    HOST_PATH="${PROJECT_ROOT}/$sensitive_path"
    if [ -d "$HOST_PATH" ]; then
        echo "⚠️ Skipping invalid path (directories not supported): $sensitive_path"
        continue
    fi

    # Ensure host file exists (Docker requirement for bind mounts).
    if [ ! -e "$HOST_PATH" ]; then
        echo "Creating placeholder: $sensitive_path"
        mkdir -p "$(dirname "$HOST_PATH")"
        touch "$HOST_PATH"
    fi

    # Path is valid: add it to our collection
    VALID_PATHS+="$sensitive_path"$'\n'
done <<< "$PATHS"

# Generate the Docker compose file with valid paths.
if [ -n "$VALID_PATHS" ]; then
    {
        echo "### Auto-generated by commands/host/create-sensitive-path-mounts - DO NOT EDIT ###"
        echo "services:"
        echo "  agents:"
        echo "    volumes:"
        # Write the validated paths into the volume block
        while read -r sensitive_path; do
            [ -z "$sensitive_path" ] && continue
            echo "      - /dev/null:/workspace/$sensitive_path:ro"
            ((PATH_COUNT++))
        done <<< "$VALID_PATHS"
    } > "$TARGET_FILE"

    # Determine if singular or plural should be used.
    PATH_COUNT_LABEL="data path"
    if [ "$PATH_COUNT" -ne 1 ]; then
        PATH_COUNT_LABEL="data paths"
    fi

    echo "✅ Generated $TARGET_FILE with mounts for $PATH_COUNT $PATH_COUNT_LABEL."
else
    echo "⚠️ No valid sensitive paths found. Removing $TARGET_FILE."
    rm -f "$TARGET_FILE"
fi
