#!/bin/bash
#ddev-generated
## Description: Creates inaccessible mounts for sensitive paths.

set -e

# Navigate to project root.
PROJECT_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$PROJECT_ROOT"

# Define the config file and target file paths.
CONFIG_FILE="${PROJECT_ROOT}/.ddev/agents.sensitive-paths.yaml"
TARGET_FILE="${PROJECT_ROOT}/.ddev/docker-compose.agents-sensitive-paths.yaml"

# Check if config file exists.
if [ ! -f "$CONFIG_FILE" ]; then
    rm -f "$TARGET_FILE"
    echo "⚠️ Agents config file not found ($CONFIG_FILE). Removing generated Docker compose file."
    exit 0
fi

# Extract the sensitive paths using Python.
PATHS=$(python3 -c "
import yaml
with open('$CONFIG_FILE', 'r') as f:
    data = yaml.safe_load(f)
    if 'sensitive_paths' in data and data['sensitive_paths']:
        print('\n'.join(data['sensitive_paths']))
" 2>/dev/null)

# Check if the sensitive paths are empty.
if [ -z "$PATHS" ]; then
    # Write an empty string (truncate the file)
    rm -f "$TARGET_FILE"
    echo "⚠️ No sensitive paths defined. Removing generated Docker compose file."
    exit 0
fi

# Generate the valid Docker compose structure.
{
    echo "### Auto-generated by commands/host/create-sensitive-data-mounts - DO NOT EDIT ###"
    echo "services:"
    echo "  agents:"
    echo "    volumes:"
} > "$TARGET_FILE"

# Loop through the paths.
PATH_COUNT=0
while read -r sensitive_path; do
    [ -z "$sensitive_path" ] && continue

    # Ensure we use the absolute project root for host operations.
    HOST_PATH="${PROJECT_ROOT}/$sensitive_path"

    # Ensure host file exists (Docker requires the source for bind mounts).
    if [ ! -e "$HOST_PATH" ]; then
        echo "Creating sensitive file as it doesn't exist: $HOST_PATH"
        mkdir -p "$(dirname "$HOST_PATH")"
        touch "$HOST_PATH"
    fi

    # Append the mount configuration.
    # Note: Inside the container, the path is relative to /workspace.
    echo "      - /dev/null:/workspace/$sensitive_path:ro" >> "$TARGET_FILE"
    ((PATH_COUNT++))
done <<< "$PATHS"

# Determine if we use singular or plural
PATH_COUNT_LABEL="data path"
if [ "$PATH_COUNT" -ne 1 ]; then
    PATH_COUNT_LABEL="data paths"
fi

echo "✅ Generated $TARGET_FILE with mounts for $PATH_COUNT $PATH_COUNT_LABEL."
