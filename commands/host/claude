#!/usr/bin/env bash

## #ddev-generated
## Description: Run Claude Code CLI in the agents container
## Usage: claude [flags] [args]
## Example: "ddev claude" or "ddev claude -p 'explain this function'"

CONTAINER="ddev-${DDEV_PROJECT}-agents"

# Verify container is running
if ! docker inspect --format='{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
  echo "Error: agents container not running. Run 'ddev start' first."
  exit 1
fi

# Fix volume ownership if needed (Docker creates named volumes as root).
# cap_drop:ALL means even "docker exec -u root" cannot chown inside the
# hardened container (CAP_CHOWN is dropped). A throwaway container runs
# outside the security boundary to set correct ownership once.
if ! docker exec "$CONTAINER" test -w /home/vscode/.claude-state 2>/dev/null; then
  VSCODE_UID=$(docker exec "$CONTAINER" id -u)
  VSCODE_GID=$(docker exec "$CONTAINER" id -g)
  docker run --rm -v "ddev-${DDEV_PROJECT}-claude-state:/state" busybox \
    chown "${VSCODE_UID}:${VSCODE_GID}" /state
fi

# Ensure persistent state symlinks exist (idempotent, handles container rebuilds)
docker exec "$CONTAINER" bash -c '
  STATE="/home/vscode/.claude-state"
  mkdir -p "$STATE/claude" "$STATE/config"
  chmod 700 "$STATE"
  # Back up any existing non-symlink files before replacing
  [ ! -e "$HOME/.claude.json" ] || [ -L "$HOME/.claude.json" ] || mv "$HOME/.claude.json" "$STATE/claude.json.bak.$(date +%s)"
  [ ! -e "$HOME/.claude" ] || [ -L "$HOME/.claude" ] || mv "$HOME/.claude" "$STATE/claude.bak.$(date +%s)"
  # Initialize claude.json with valid empty JSON if it does not exist
  [ -s "$STATE/claude.json" ] || echo "{}" > "$STATE/claude.json"
  ln -sfn "$STATE/claude.json" "$HOME/.claude.json"
  ln -sfn "$STATE/claude" "$HOME/.claude"
'

# TTY detection for interactive vs headless
TTY_FLAGS="-i"
if [ -t 0 ]; then
  TTY_FLAGS="-it"
fi

# Execute claude, passing through all arguments
docker exec $TTY_FLAGS -w /workspace "$CONTAINER" \
  /home/vscode/.local/bin/claude "$@"
