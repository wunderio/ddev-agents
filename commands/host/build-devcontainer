#!/bin/bash
#ddev-generated

## Description: Pull a prebuilt devcontainer image, or build it locally, before DDEV starts
## Usage: build-devcontainer [--local] [--no-cache]
## Example: "ddev build-devcontainer" or "ddev build-devcontainer --local" or "ddev build-devcontainer --no-cache"
## Flags: [{"Name":"local","Usage":"Skip the prebuilt image and build locally"},{"Name":"no-cache","Usage":"Build locally without Docker build cache (forces full rebuild)"}]

set -e

PREBUILT_REPO="wunderio/ddev-agents-devcontainer"

NO_CACHE=""
LOCAL_ONLY=""
[ "${DDEV_AGENTS_LOCAL_BUILD:-}" = "1" ] && LOCAL_ONLY="DDEV_AGENTS_LOCAL_BUILD=1"
for arg in "$@"; do
    case "$arg" in
        --local) LOCAL_ONLY="--local" ;;
        --no-cache) NO_CACHE="--no-cache"; LOCAL_ONLY="--no-cache" ;;
    esac
done

# Navigate to project root
PROJECT_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$PROJECT_ROOT"

# Get DDEV project name - DDEV sets $DDEV_PROJECT for exec-host hooks automatically.
# Avoid re-reading it via `ddev describe -j` since DDEV_DEBUG mode injects extra JSON
# objects into stdout that break jq parsing.
: "${DDEV_PROJECT:=ddev-agents}"
IMAGE_NAME="ddev-${DDEV_PROJECT}-devcontainer:latest"

echo "🔍 Project: $DDEV_PROJECT"

# ==============================================================================
# Resolve version placeholders from .ddev/config.yaml
# ==============================================================================
DDEV_CONFIG="$PROJECT_ROOT/.ddev/config.yaml"
PHP_VERSION=""
NODE_VERSION=""

if [ -f "$DDEV_CONFIG" ]; then
    PHP_VERSION=$(grep -E '^\s*php_version:' "$DDEV_CONFIG" | sed -E 's/.*php_version:[[:space:]]*"?([^"]*)"?/\1/' | xargs)
    NODE_VERSION=$(grep -E '^\s*nodejs_version:' "$DDEV_CONFIG" | sed -E 's/.*nodejs_version:[[:space:]]*"?([^"]*)"?/\1/' | xargs)
fi

# Defaults if not found
PHP_VERSION="${PHP_VERSION:-8.3}"
NODE_VERSION="${NODE_VERSION:-22}"

echo "📍 PHP version: $PHP_VERSION"
echo "📍 Node.js version: $NODE_VERSION"

# ==============================================================================
# Prebuilt image from Docker Hub (built by .github/workflows/devcontainer-images.yml)
# ==============================================================================
# Any miss — unsupported version, customized build config, registry unreachable —
# falls through to the local build below.
NODE_MAJOR="${NODE_VERSION%%.*}"
IMAGE_TAG_SCRIPT="$PROJECT_ROOT/.devcontainer/scripts/image-tag.sh"

if [ -n "$LOCAL_ONLY" ]; then
    echo "ℹ️  Skipping prebuilt image ($LOCAL_ONLY), building locally..."
elif ! [[ "$PHP_VERSION" =~ ^[0-9]+\.[0-9]+$ && "$NODE_MAJOR" =~ ^[0-9]+$ ]]; then
    echo "ℹ️  No prebuilt image for PHP '$PHP_VERSION' / Node '$NODE_VERSION', building locally..."
elif ! command -v docker &> /dev/null || [ ! -f "$IMAGE_TAG_SCRIPT" ]; then
    echo "ℹ️  Cannot resolve prebuilt image, building locally..."
else
    CONFIG_HASH=$(bash "$IMAGE_TAG_SCRIPT" "$PROJECT_ROOT/.devcontainer")
    PREBUILT_IMAGE="${PREBUILT_REPO}:php${PHP_VERSION}-node${NODE_MAJOR}-${CONFIG_HASH}"
    echo "📦 Pulling prebuilt image: $PREBUILT_IMAGE"

    if docker pull "$PREBUILT_IMAGE"; then
        docker tag "$PREBUILT_IMAGE" "$IMAGE_NAME"
        echo "✅ Using prebuilt devcontainer image: $IMAGE_NAME"
        exit 0
    elif docker image inspect "$PREBUILT_IMAGE" &> /dev/null; then
        docker tag "$PREBUILT_IMAGE" "$IMAGE_NAME"
        echo "⚠️  Pull failed, using previously pulled image: $PREBUILT_IMAGE"
        exit 0
    fi

    echo "ℹ️  No prebuilt image found for php${PHP_VERSION}-node${NODE_MAJOR}-${CONFIG_HASH}, building locally..."
fi

# ==============================================================================
# Local build
# ==============================================================================
echo "🔨 Building devcontainer image..."

echo "⌛️ Checking for required tools..."

if ! command -v jq &> /dev/null; then
    echo "❌ jq CLI not found. Please install jq first."
    exit 1
fi

if ! command -v npm &> /dev/null; then
    echo "❌ npm CLI not found. Please install Node.js and npm first."
    exit 1
fi

# Check node version for devcontainer CLI compatibility:
HOST_NODE_VERSION=$(node -v 2>/dev/null || echo "v0.0.0")
HOST_NODE_VERSION="${HOST_NODE_VERSION#v}"
echo "📍 Host Node.js version: $HOST_NODE_VERSION"
REQUIRED_NODE_MAJOR=20
HOST_NODE_MAJOR=$(echo "$HOST_NODE_VERSION" | cut -d. -f1)
if [ "$HOST_NODE_MAJOR" -lt "$REQUIRED_NODE_MAJOR" ]; then
    echo "❌ Node.js version $HOST_NODE_VERSION is not supported. Please install Node.js v${REQUIRED_NODE_MAJOR}.0.0 or higher."
    exit 1
fi

echo "✅ All required tools are available."

echo "🔨 Building image: $IMAGE_NAME"

# Check if devcontainer CLI is available
if ! command -v devcontainer &> /dev/null; then
    echo "⚠️  devcontainer CLI not found. Installing..."
    npm install -g @devcontainers/cli
fi

# Create a temp copy of build config with resolved placeholders
BUILD_CONFIG_TEMPLATE="$PROJECT_ROOT/.devcontainer/devcontainer.build.json"
BUILD_CONFIG="$PROJECT_ROOT/.devcontainer/devcontainer.build.resolved.json"
sed -e "s|__PHP_VERSION__|${PHP_VERSION}|g" \
    -e "s|__NODE_VERSION__|${NODE_VERSION}|g" \
    -e "s|__PROJECT_NAME__|${DDEV_PROJECT}|g" \
    "$BUILD_CONFIG_TEMPLATE" > "$BUILD_CONFIG"

if [ -n "$NO_CACHE" ]; then
    echo "🚀 Building with devcontainer CLI (no cache — full rebuild)..."
else
    echo "🚀 Building with devcontainer CLI (features will be installed)..."
fi

# Build using devcontainer CLI - this will install all the features
devcontainer build \
    --workspace-folder "$PROJECT_ROOT" \
    --image-name "$IMAGE_NAME" \
    --config "$BUILD_CONFIG" \
    $NO_CACHE

BUILD_EXIT_CODE=$?

# Clean up temp file
rm -f "$BUILD_CONFIG"

if [ $BUILD_EXIT_CODE -ne 0 ]; then
    echo "❌ Devcontainer build failed with exit code $BUILD_EXIT_CODE"
    exit $BUILD_EXIT_CODE
fi

echo "✅ Devcontainer image built successfully: $IMAGE_NAME"
echo "   VS Code will attach to this pre-built image via docker-compose"
