{
  "mcpServers": {
    "wdrmcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@wunderio/wdrmcp",
        "--tools-config",
        "{{toolsConfigPath}}"
      ],
      "env": {
        "DDEV_PROJECT": "{{projectName}}"
      },
      "tools": ["*"]
    },
    "wunder-quality-system": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "supergateway",
        "--streamableHttp",
        "https://quality.wunder.io/mcp",
        "--oauth2Bearer",
        "{{wqsApiKey}}"
      ],
      "tools": ["*"]
    }
  }
}
