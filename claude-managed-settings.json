{
  "disableBypassPermissionsMode": "disable",
  "permissions": {
    "allow": [
      "WebSearch",

      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(test *)",
      "Bash(command -v *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(tee *)",
      "Bash(xargs *)",

      "Bash(php *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(bash *)",

      "Bash(composer *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)",

      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git rm *)",

      "Bash(./vendor/bin/phpunit *)",
      "Bash(./vendor/bin/phpcs *)",
      "Bash(./vendor/bin/phpcbf *)",
      "Bash(./vendor/bin/phpstan *)",
      "Bash(./vendor/bin/grumphp *)",

      "Bash(drush *)",
      "Bash(./vendor/bin/drush *)",

      "Bash(apt list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*secrets*)",
      "Read(./**/credentials*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.npmrc)",
      "Read(./**/.htpasswd)",
      "Read(./wp-config.php)",
      "Read(./**/settings.local.php)",
      "Bash(git push*)",
      "Bash(git remote*)",
      "Bash(git checkout*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(npm publish*)",
      "Bash(composer publish*)",
      "Bash(ssh *)",
      "Bash(*drush sql-drop*)",
      "Bash(*drush sql:drop*)",
      "Bash(*drush sql-create*)",
      "Bash(*drush sql:create*)",
      "Bash(*drush sql-sync*)",
      "Bash(*drush sql:sync*)",
      "Bash(*drush site-install*)",
      "Bash(*drush site:install*)",
      "Bash(*drush si *)"
    ]
  }
}
