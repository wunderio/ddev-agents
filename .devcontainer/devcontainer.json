{
  "containerEnv": {
    "GH_TOKEN": "${localEnv:DDEV_AGENTS_GH_TOKEN}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:DDEV_AGENTS_GH_TOKEN}",
    "SSH_AUTH_SOCK": ""
  },
  "name": "Agents: __PROJECT_NAME__",
  "dockerComposeFile": [
    "../.ddev/.ddev-docker-compose-full.yaml"
  ],
  "service": "agents",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "__NODE_VERSION__"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "__PHP_VERSION__",
      "installComposer": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "davidanson.vscode-markdownlint",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "git.enabled": true,
        "workbench.activityBar.visible": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "github.copilot.enable": {
          "*": true
        },
        "editor.formatOnSave": true,
        "chat.mcp.gallery.enabled": true,
        "chat.mcp.gallery.serviceUrl": "https://mcp.wdr.io"
      }
    },
    "jetbrains": {
      "backend": "PhpStorm",
      "plugins": [
        "org.jetbrains.plugins.github",
        "org.intellij.plugins.markdown",
        "Docker",
        "com.github.copilot"
      ]
    }
  },
  "postAttachCommand": "STATE=/home/vscode/.claude-state && mkdir -p $STATE/claude $STATE/config && chmod 700 $STATE && { [ ! -e ~/.claude.json ] || [ -L ~/.claude.json ] || mv ~/.claude.json $STATE/claude.json.bak.$(date +%s); } && { [ ! -e ~/.claude ] || [ -L ~/.claude ] || mv ~/.claude $STATE/claude.bak.$(date +%s); } && { [ -s $STATE/claude.json ] || echo '{}' > $STATE/claude.json; } && ln -sfn $STATE/claude.json ~/.claude.json && ln -sfn $STATE/claude ~/.claude && echo '✅ Secure Agents Environment Active'",
  "remoteUser": "vscode"
}
